// ▽メイン▽
.topMain.main
	.topKvPanel
		.topKv
			.kvTitleTxt
				h1 長年の経験と知識を活かし金属を削り続けます。
			.kvTitleBox
				.kvTitle01.kvTitle
					p 長年の経験と
					p.green 知識
					p を活かし
				.kvTitle02.kvTitle
					p.blue 金属
					p を削り続けます。
		.scrollBox
			.scroll
				img(src="https://sanwakogyosho240401.smooooth.jp/system_panel/uploads/images/top_scroll_txt.png", alt="")
	.sec01
		.titlePanel
			.secWrap01
				.pageSecTtlBox
					p ABOUT US
					h2 私たちについて
				h3 金属と技術を削り続ける
		.txtPanel
			.secWrap01
				.txt
					p 私たちの仕事は、金属を削ることです。<br>傷なく、寸分の狂いもなく仕上げるには、<br>金属の特性を理解すること、そして何より長年の経験と高い技術が必要です。<br>創業からおよそ50 年、私たちは日々金属を削り続けてきました。<br>これからも、お客さまの多様なご要望にお応えできるよう、<br>もくもくと、ひたむきに、金属を研削し続けます。
				.btnMore
					a(href="service")
						div
							p 事業紹介
	.sec02
		.secWrap
			.titlePanel
				.pageSecTtlBox
					p RECRUIT
					h2 採用情報
				h3 毎日もくもくと向き合える仕事
				.txt
					p 仲間と協力し合いながら、<br>毎日もくもくと、金属や機械と向き合う仕事です。<br>未経験者にはいくつかの段階に分けて、丁寧に教えます。<br>何歳からでも始められる金属研磨加工、三和工業所で始めてみませんか？
			.secBoxList
				.secBox01.secBox
					.ttlBox01.ttlBox
						p RECRUIT
					.listBox01.listBox
						.ul
							.li
								a(href="career")
									.ttl
										p 経験者向け
									.photo
										img(src="https://sanwakogyosho240401.smooooth.jp/system_panel/uploads/images/top_sec02_img_01.png", alt="")
							.li
								a(href="beginner")
									.ttl
										p 未経験者向け
									.photo
										img(src="https://sanwakogyosho240401.smooooth.jp/system_panel/uploads/images/top_sec02_img_02.png", alt="")
				.secBox02.secBox
					.ttlBox02.ttlBox
						p SANWAKOGYO
					.listBox02.listBox
						.ul
							.li
								a(href="women")
									.ttl
										p 女性向け
									.photo
										img(src="https://sanwakogyosho240401.smooooth.jp/system_panel/uploads/images/top_sec02_img_03.png", alt="")
							.li
								a(href="senior")
									.ttl
										p シニア向け
									.photo
										img(src="https://sanwakogyosho240401.smooooth.jp/system_panel/uploads/images/top_sec02_img_04.png", alt="")

// ▽メイン▽
.scheduleMain.main
    .pageTitlePanel
        p TIME SCHEDULE
        h1 1日の流れ
    .sec01
        .secWrap01
            h2 ある日のスケジュール
            .flowListPanel
                //- .flowListTtl
                //-     h3 ある日のスケジュール
                .flowListBox
                    .flowList.clearfix
                        .flow01.itemBox.left
                            .time.timeL
                                p.span 8:00
                                p.em 業務開始
                            .dl
                                .dt
                                    p 業務開始
                                .dd
                                    p 出社後、今日の業務を確認したら業務スタート。<br>施工作業を開始します。
                        .flow02.itemBox.right
                            .time.timeR
                                p.em 勤務中
                                p.span 9:30
                            .dl
                                .dt
                                    p 勤務中
                                .dd
                                    p ジュースや珈琲は持ち込んでいただいて構いません。<br>水分補給をしっかり取りながら作業に向き合ってください。
                    .flowList.clearfix
                        .flow03.itemBox.left
                            .time.timeL
                                p.span 12:00
                                p.em お昼休み（12:00 - 12:45）
                            .dl
                                .dt
                                    p お昼休み（12:00 - 12:45）
                                .dd
                                    p お昼休憩を取ります。<br>お弁当や外で購入した食事をお楽しみください。<br>仕出し弁当は会社が50%負担で食べることができます♪
                        .flow04.itemBox.right
                            .time.timeR
                                p.em 午後作業開始
                                p.span 12:45
                            .dl
                                .dt
                                    p 午後作業開始
                                .dd
                                    p お昼休み終了後施工作業を再開します。
                                    .img
                                        img(src="https://sanwakogyosho240401.smooooth.jp/system_panel/uploads/images/schedule_sec01_img_01.png", alt="")
                    .flowList.clearfix
                        .flow05.itemBox.left
                            .time.timeL
                                p.span 14:30
                                p.em 飲み物支給
                            .dl
                                .dt
                                    p 飲み物支給
                                .dd
                                    p お茶や缶コーヒーを提供します。<br>疲れを癒す一息をついて、元気に作業を続けましょう。
                        .flow06.itemBox.right
                            .time.timeR
                                p.em 作業終了
                                p.span 16:20
                            .dl
                                .dt
                                    p 作業終了
                                .dd
                                    p 作業終了。<br>後片付けを行った後、帰宅します。<br>終業が早いので、プライベートにお時間を有効に充てることができます。
                                    .img
                                        img(src="https://sanwakogyosho240401.smooooth.jp/system_panel/uploads/images/schedule_sec01_img_02.png", alt="")
// △メイン△
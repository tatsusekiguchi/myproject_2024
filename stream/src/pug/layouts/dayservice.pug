				.infoList.fadeUp
					.ttlBox
						.ttl01
							img(src="https://stream-gr.com/system_panel/uploads/images/schedule_sub_ttl_01.png", alt="")
					.infoBox
						.dl
							.dt
								p 14：00
							.dd
								p 学校にお迎え・かめ吉へ

// ▽メイン▽
.dayserviceMain.pageMain.serviceMain.main
	.pageTopTitle
		h1 放課後等デイサービス
	.topSection
		.secWrap
			.topBox01
				.icon
					img(src="https://stream-gr.com/system_panel/uploads/images/dayservice_top_icon.png", alt="")
				.ttl
					img(src="https://stream-gr.com/system_panel/uploads/images/dayservice_top_ttl.png", alt="")
			.topBox02
				.txt
					p 放課後等デイサービスの「かめ吉」では、障がいや発達に特性をもつ子どもたちが、夢中になれることを見つけ、かめのようにゆっくりマイペースに生活できるようサポートしています。<br>日替わりでレクリエーションを用意し、社会に出るための協調性を身に着けながら、好きなことを見つけられる機会を作っています。<br>小学生から高校生まで（６歳～１8歳、特例で20歳まで）が対象です。<br>療育の場として、放課後や週末、夏休みの居場所、レスパイトケア（ご家族のリフレッシュ）にもご利用ください。
	.activitySection
		.secWrap01
			.secTtl.fadeUp
				h2 日々の活動
				img(src="https://stream-gr.com/system_panel/uploads/images/activity_sec_ttl.png", alt="")
			.listBox
				.ul.listAnim
					.li
						img(src="https://stream-gr.com/system_panel/uploads/images/dayservice_activity_img_01.png", alt="")
					.li
						img(src="https://stream-gr.com/system_panel/uploads/images/dayservice_activity_img_02.png", alt="")
					.li
						img(src="https://stream-gr.com/system_panel/uploads/images/dayservice_activity_img_03.png", alt="")
					.li
						img(src="https://stream-gr.com/system_panel/uploads/images/dayservice_activity_img_04.png", alt="")
					.li
						img(src="https://stream-gr.com/system_panel/uploads/images/dayservice_activity_img_05.png", alt="")
					.li
						img(src="https://stream-gr.com/system_panel/uploads/images/dayservice_activity_img_06.png", alt="")
			.iconTop.iconTop01.fadeUp
				img(src="https://stream-gr.com/system_panel/uploads/images/activity_icon_01.png", alt="")
			.iconBtm.iconBtm01.fadeUp
				img(src="https://stream-gr.com/system_panel/uploads/images/activity_icon_01_reverse.png", alt="")
	.scheduleSection
		.secWrap01
			.secTtl.fadeUp

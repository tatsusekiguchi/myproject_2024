// ▽メイン▽
.reasonMain.main
	.pageKvPanel
		.pageKvTtl.mincho
			h1 GTSが選ばれる理由
	.reasonSection
		.topSecTtlContainer
			.secWrap01
				.pageSecTtlBox
					.pageSecTtl
						p REASON
						h2 GTSが選ばれる理由
				.numberPanel
					.ttlBox
						h3 GTSの強み01
						p 0ne-stop<br>service
					.txtBox
						h4.mincho ご依頼から施工までワンストップで対応
						.txt
							p ご相談から加工、納品まで一貫して自社で行なっております。<br>一貫してお任せいただくことで、スケジュールの調整など柔軟に対応できます。<br>さらに業者を挟まないことで費用の削減、納期の短縮を実現できます。
		.listContainer
			.secWrap01
				.listPanel
					.ol.listAnim
						.li.list01
							.dl
								.dt.mincho
									p 1.打合せ
								.dd
									p 打合せにでご依頼の図面を確認させていただきます。
						.li.list02
							.dl
								.dt.mincho
									p 2.加工
								.dd
									p 自社工場で加工。<br>高い技術力、正確性を持つ職人が丁寧に仕上げます。
						.li.list03
							.dl
								.dt.mincho
									p 3.確認
								.dd
									p 加工後、ご依頼通りできているかしっかり確認いたします。
						.li.list04
							.dl
								.dt.mincho
									p 4.納品
								.dd
									p 完成したら納品です。<br>ご要望に合わせたスケジュールで納品させていただきます。
		.stepSecContainer01.stepSecContainer
			.secWrap01
				.numberPanel
					.ttlBox
						h3 GTSの強み02
						p Versatile<br>expertise
					.txtBox
						h4.mincho 多様な素材に対応する技術力
						.txt
							p 金属・非鉄金属・樹脂など、さまざまな素材に対して高精度な加工が可能です。<br>自動車部品や医療器具、輸送関連、建築用耐震部品など、幅広い業種に対応できる柔軟性が強みです。<br>過去には人工衛星のジュラルミン部品の加工やバルブメーカーの半導体製造装置向け高精度高品質バルブ部品加工などの実績もございます。
			.photoListPanel
				.photoList
					.ul
						.li
							img(src="https://s-1401513.smooooth.jp/system_panel/uploads/images/reason_photo_list_01.png", alt="")
						.li
							img(src="https://s-1401513.smooooth.jp/system_panel/uploads/images/reason_photo_list_02.png", alt="")
						.li
							img(src="https://s-1401513.smooooth.jp/system_panel/uploads/images/reason_photo_list_03.png", alt="")
				.btnMore
					a(href="service?sec02")
						div
							p 実績を見る
		.stepSecContainer02.stepSecContainer
			.secWrap01
				.numberPanel
					.ttlBox
						h3.gothic GTSの強み03
						p Fully equipped<br>facilities
					.txtBox
						h4.mincho 自社工場の充実した設備
						.txt
							p 自社工場にフライス盤やタレット旋盤など豊富に機械を取り揃え、<br>自社一貫での工事を可能にしています。
			.photoListPanel
				.photoList
					.ul
						.li
							img(src="https://s-1401513.smooooth.jp/system_panel/uploads/images/reason_photo_list_04.png", alt="")
						.li
							img(src="https://s-1401513.smooooth.jp/system_panel/uploads/images/reason_photo_list_05.png", alt="")
						.li
							img(src="https://s-1401513.smooooth.jp/system_panel/uploads/images/reason_photo_list_06.png", alt="")
				.btnMore
					a(href="facility")
						div
							p 設備を見る
		.stepSecContainer03.stepSecContainer
			.secWrap01
				.numberPanel
					.ttlBox
						h3.gothic GTSの強み04
						p Reliability and<br>swift responsiveness
					.txtBox
						h4.mincho 長年の経験からくる信頼性と迅速な対応力
						.txt
							p 30年以上の業歴を誇る当社は、人工衛星の部品製造にも携わってきた実績があります。<br>少ない人数で加工をしている為、沢山の量を納品することは難しいかもしれません。<br>しかし、小規模だからこそ困難なプロジェクトにも柔軟に対応し、クライアントから高い信頼と評価をいただいております。

script.
    $(document).ready(function() {

        $('.formBox input, .formBox select, textarea').each(function(index, element){
            let id = $(element).attr('id');
            let parents =  $(element).parents('.inputItem').find("dt").text();
            console.log(parents+'\n'+id);
        });

        setSchoolSelect('air_summer_ward');

        let today = new Date();
        let year = today.getFullYear();
        let month = today.getMonth() + 1;
        let day = today.getDate();
        let title = '教室の夏季空気検査表';
        let ward,
            school;

        $('#category').val('5');

        $('.btnSubmit').on('click', function() {
            ward = $('#air_summer_ward').val();
            school = $('#air_summer_school_name').val();
            title += '[' + ward + '区]';
            title += '[' + school + ']';
            title += '[' + year + '年' + month + '月' + day + '日' + ']';

            $('#post_title_11').val(title);

            $('.formBox input[type="text"], .formBox select, textarea').each(function(index, element) {
                let id = $(element).attr('id');
                $('#' + id + '_401').val($(element).val());
            });

            $('.formBox input[type="radio"]:checked').each(function(index, element) {
                let name = $(element).attr('name').slice(0, -3);
                $("input[name='" + name + "'][value='" + $(element).val() + "']").prop('checked', true);
            });
            $('.wpuf-submit-button').click();
        });

        // 合計を計算し表示する関数
        function calculateTotal() {
            var studentCount = parseInt($('#air_summer_student').val()) || 0;  // 生徒の数、空または非数の場合は0を使用
            var staffCount = parseInt($('#air_summer_staff').val()) || 0;      // 職員の数、空または非数の場合は0を使用
            var inspectorCount = parseInt($('#air_summer_inspector').val()) || 0; // 検査員の数、空または非数の場合は0を使用

            var totalPeople = studentCount + staffCount + inspectorCount;  // 合計を計算
            $('#air_summer_total_people').val(totalPeople);               // 合計フィールドに値をセット
        }

        // 生徒、職員、検査員のフィールドのいずれかの値が変更された場合に合計を再計算
        $('#air_summer_student, #air_summer_staff, #air_summer_inspector').on('input', calculateTotal);

        // 指定されたinput要素に対して入力制限を設定
        $('#air_summer_temperature_room, #air_summer_temperature_outside, #air_summer_temperature_difference').on('input', function() {
            // 現在の入力値を取得
            var currentValue = $(this).val();
            // 正規表現を用いて、入力値が数値および小数点第一位までの形式か検証
            var match = currentValue.match(/^\d*\.?\d{0,1}/);
            // 正規表現に一致する部分を入力値とする（一致しない入力は削除される）
            this.value = match ? match[0] : '';
        });

        // 入力が変更されたときに温度差を計算する関数
        function calculateTemperatureDifference() {
            var indoorTemp = parseFloat($('#air_summer_temperature_room').val());  // 室内温度を数値に変換
            var outdoorTemp = parseFloat($('#air_summer_temperature_outside').val());  // 外気温度を数値に変換

            // 両方の温度が正しく入力されているか確認
            if (!isNaN(indoorTemp) && !isNaN(outdoorTemp)) {
                var difference = indoorTemp - outdoorTemp;  // 温度差を計算
                $('#air_summer_temperature_difference').val(difference.toFixed(1));  // 温度差を小数点第一位まで表示してセット
            } else {
                $('#air_summer_temperature_difference').val('');  // 不適切な入力がある場合は空にする
            }
        }

        // 室内温度または外気温度が変更された場合に温度差を再計算
        $('#air_summer_temperature_room, #air_summer_temperature_outside').on('input', calculateTemperatureDifference);

        $('#air_summer_dust').on('input', function() {
            // 現在の入力値を取得
            var currentValue = $(this).val();
            // 正規表現を用いて、入力値が数値および小数点第三位までの形式か検証
            var match = currentValue.match(/^\d*\.?\d{0,3}/);
            // 正規表現に一致する部分を入力値とする（一致しない入力は削除される）
            this.value = match ? match[0] : '';
        });
    });
// △メイン△
script.
    $(document).ready(function() {

        setSchoolSelect('noise_summer_ward');

        let today = new Date();
        let year = today.getFullYear();
        let month = today.getMonth() + 1;
        let day = today.getDate();
        let title = '教室の騒音定期検査表(夏季)';
        let ward,
            school;

        $('#category').val('4');

        $('.btnSubmit').on('click', function() {
            ward = $('#noise_summer_ward').val();
            school = $('#noise_summer_school_name').val();
            title += '[' + ward + '区]';
            title += '[' + school + ']';
            title += '[' + year + '年' + month + '月' + day + '日' + ']';

            $('#post_title_11').val(title);

            $('.formBox input[type="text"], .formBox select, textarea').each(function(index, element) {
                let id = $(element).attr('id');
                $('#' + id + '_401').val($(element).val());
            });

            $('.formBox input[type="radio"]:checked').each(function(index, element) {
                let name = $(element).attr('name').slice(0, -3);
                $("input[name='" + name + "'][value='" + $(element).val() + "']").prop('checked', true);
            });
            $('.wpuf-submit-button').click();
        });

        $('.registNoiseTable .unit').on('input', function() {
            var validValue = this.value.match(/^\d*\.?\d{0,1}/);
            this.value = validValue ? validValue[0] : '';
        });

        // 窓閉鎖の開始時間入力に対する処理
        $('#noise_summer_close_measuring_hour, #noise_summer_close_measuring_minutes').on('input', function() {
            var hour = $('#noise_summer_close_measuring_hour').val();
            var minute = $('#noise_summer_close_measuring_minutes').val();
            var formattedTime = (hour ? hour : "00") + ":" + (minute ? minute : "00");
            $('#noise_summer_close_measuring_time').val(formattedTime);
        });

        // 窓閉鎖の終了時間入力に対する処理
        $('#noise_summer_close_measuring_hour_to, #noise_summer_close_measuring_minutes_to').on('input', function() {
            var hour = $('#noise_summer_close_measuring_hour_to').val();
            var minute = $('#noise_summer_close_measuring_minutes_to').val();
            var formattedTime = (hour ? hour : "00") + ":" + (minute ? minute : "00");
            $('#noise_summer_close_measuring_time_to').val(formattedTime);
        });

        // 窓開放の開始時間入力に対する処理
        $('#noise_summer_open_measuring_hour, #noise_summer_open_measuring_minutes').on('input', function() {
            var hour = $('#noise_summer_open_measuring_hour').val();
            var minute = $('#noise_summer_open_measuring_minutes').val();
            var formattedTime = (hour ? hour : "00") + ":" + (minute ? minute : "00");
            $('#noise_summer_open_measuring_time').val(formattedTime);
        });

        // 窓開放の終了時間入力に対する処理
        $('#noise_summer_open_measuring_hour_to, #noise_summer_open_measuring_minutes_to').on('input', function() {
            var hour = $('#noise_summer_open_measuring_hour_to').val();
            var minute = $('#noise_summer_open_measuring_minutes_to').val();
            var formattedTime = (hour ? hour : "00") + ":" + (minute ? minute : "00");
            $('#noise_summer_open_measuring_time_to').val(formattedTime);
        });
    });
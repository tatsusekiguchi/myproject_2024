// ▽メイン▽
.salesPurchaseMain.main
    .pageTopPanel
    .mainContainer
        .mainContainer__wrap
            .mainContainer__left
                include /common/sideNav.pug
            .mainContainer__right
                .sec01.section
                    .secTtl
                        h2 売却相談
                    .secPanel
                        .pointTxt
                            .pointTxt01
                                p 売却相談について必要な
                            .pointTxt02.gothic
                                p.em 3
                                p つのポイント
                        .listBox.gothic
                            .ul
                                .li
                                    p 売却理由
                                .li
                                    p 売却希望時期
                                .li
                                    p 売却希望金額
                    .messageBox01
                        .message
                            p 物件査定（無料）をご希望の方、
                        .message
                            p.em お気軽にご相談ください！
                    .pageLinePanel
                        .pTtl.gothic
                            h2 LINEからお問い合わせ
                        .secBox
                            .qr
                                a(href="https://page.line.me/438hjtlc?oat_content=url&openQrModal=true", target="_blank", rel="noopener")
                                    div
                                        img(src="https://onda-net.co.jp/system_panel/uploads/images/page_line_qr.png", alt="")
                            .txtBox
                                .txt
                                    p 物件査定（無料）をご希望の方、<br>LINEからお問い合わせください。
                                .txt
                                    p.em いただきたい情報
                                    p ・所有者のお名前<br>・査定を希望する不動産の住所、お住まいの住所
                .sec02.section
                    .secTtl
                        h2 買取相談
                    .secBox
                        .photo
                            img(src="https://onda-net.co.jp/system_panel/uploads/images/salesPurchase_sec02_img.png", alt="")
                        .txtBox
                            .ttlBox
                                .ttl
                                    p 査定（無料）
                                .sub
                                    p こんなお悩みでお困りの方へ！
                            .txt
                                p □ 安くてもいいので来月までにお金をつくりたい。<br>□ 短期間で査定・買取してほしい。<br>□ アパート経営を辞めたいが、後継ぎがいない。<br>□ 家が古くなってきたが、リフォームする資金がない。<br>□ 空き家が増えてきたが、建て替えるつもりはない。
                    .secPanel
                        .pointTxt
                            .pointTxt01
                                p 買取相談
                            .pointTxt02.gothic
                                p.em 3
                                p つのポイント
                        .listBox.gothic
                            .ul
                                .li
                                    p お金が必要な時期
                                .li
                                    p 内密に売却
                                .li
                                    p 買取希望金額
                    .messageBox01
                        .message
                            p 物件査定（無料）をご希望の方、
                        .message
                            p.em お気軽にご相談ください！
                    .pageLinePanel
                        .pTtl.gothic
                            h2 LINEからお問い合わせ
                        .secBox
                            .qr
                                a(href="https://page.line.me/438hjtlc?oat_content=url&openQrModal=true", target="_blank", rel="noopener")
                                    div
                                        img(src="https://onda-net.co.jp/system_panel/uploads/images/page_line_qr.png", alt="")
                            .txtBox
                                .txt
                                    p 物件査定（無料）をご希望の方、<br>LINEからお問い合わせください。
                                .txt
                                    p.em いただきたい情報
                                    p ・所有者のお名前<br>・査定を希望する不動産の住所、お住まいの住所
// △メイン△
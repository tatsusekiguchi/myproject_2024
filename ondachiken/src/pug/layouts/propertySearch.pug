.propertySearchMain.main
    .pageTopPanel
    .mainContainer
        .mainContainer__wrap
            .mainContainer__left
                include /common/sideNav.pug
            .mainContainer__right
                .section
                    .secTtl.gothic
                        h2 不動産を探す
                    p ご希望の条件をご指定ください。表示する物件を絞り込めます。
                    .searchPanel.gothic
                        <form class="webgene-search-form" method="get" action="./">
                            <div rel="物件種類" title="物件種類" class="webgene-search-form-block">
                                <div class="search-title-wrapper">
                                    <p class="search-title">物件種類</p>
                                </div>
                                <div class="search-area-wrapper">
                                    <div class="search-subtitle-wrapper"></div>
                                    <div class="search-contents-wrapper">
                                        <label><input type="checkbox" class="property_type_cd" name="s0l0[]" value="1">土地 </label>
                                        <label><input type="checkbox" class="property_type_cd" name="s0l0[]" value="2">建物</label>
                                        <label><input type="checkbox" class="property_type_cd" name="s0l0[]" value="3">投資物件</label>
                                        <label><input type="checkbox" class="property_type_cd" name="s0l0[]" value="4">テナント</label>
                                    </div>
                                </div>
                            </div>
                            <input type="submit" class="search-submit" value="検索する"><input type="hidden" name="wgsearch" value="property"><input type="hidden" name="sg[]" value="s2|s4|s6,s3|s5|s7">

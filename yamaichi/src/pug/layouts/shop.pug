// ▽メイン▽
main#shop.main
	.pageKvPanel
		.pageKvTitle
			p SHOP
			h1 店舗紹介
	.sec01
		.secWrap01
			.pageSecTtlBox
				.pageSecTtl
					p YAMAICHI
					h2 山一
			.infoBox
				dl
					dt 店名
					dd 山一
				dl
					dt 住所
					dd 愛知県豊田市四郷町千田63
				dl
					dt 電話番号
					dd
						a(href="tel:0565450378") 0565-45-0378
				dl
					dt 営業時間
					dd 10:00〜19:00
				dl
					dt 定休日
					dd 火曜日
				dl
					dt 駐車場
					dd 15台（STORIA共用）
			.listBox
				ul
					li
						.photo
							img(src=(root_path || '') + "image/shop/shop_sec01_list_01.png", alt="")
						p とても広々とした駐車場は15台分<br>車間が広いので安心してお停めいただけます。
					li
						.photo
							img(src=(root_path || '') + "image/shop/shop_sec01_list_02.png", alt="")
						p 個別スペースで<br>落ち着いてご相談いただけます。
					li
						.photo
							img(src=(root_path || '') + "image/shop/shop_sec01_list_03.png", alt="")
						p クリーニングやメンテナンスも<br>お任せください。
	.slidePanel
		.slideBox
			ul
				li
					img(src=(root_path || '') + "image/shop/shop_slide_01.png", alt="")
				li
					img(src=(root_path || '') + "image/shop/shop_slide_02.png", alt="")
				li
					img(src=(root_path || '') + "image/shop/shop_slide_03.png", alt="")
				li
					img(src=(root_path || '') + "image/shop/shop_slide_04.png", alt="")
				li
					img(src=(root_path || '') + "image/shop/shop_slide_05.png", alt="")
	.mapPanel
		.mapBox
			<iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3263.1755537578033!2d137.1635003757632!3d35.127292372771166!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x60035f998f3a0f0d%3A0xd1e613140019b9a9!2z5bGx5LiAICjml6cg5a6d55-z44Gu5bGx5LiA77yJ!5e0!3m2!1sja!2sjp!4v1723188745055!5m2!1sja!2sjp" allow="fullscreen"></iframe>
	.sec02
		.secWrap01
			.pageSecTtlBox
				.pageSecTtl
					p ACCSESS
					h2 アクセス
			.secBox01
				.photo
					img(src=(root_path || '') + "image/shop/shop_sec02_img_01.png", alt="")
				.txtBox
					.box
						.ttl
							h3 お車でお越しの場合
						dl
							dt 猿投グリーンロード
							dd 猿投ICから車で約10分
						dl
							dt 東海環状自動車道
							dd 豊田勘八 ICから車で約15分
					.box
						.ttl
							h3 電車でお越しの場合
						dl
							dt 愛知環状鉄道線
							dd 四郷駅から徒歩で約15分
			.secBox02
				.photo
					img(src=(root_path || '') + "image/shop/shop_sec02_img_02.png", alt="")
				.txtBox
					.sub
						p 豊田市内・みよし市内
					h3 出張訪問サービス
					.txt
						p ご高齢の方や、交通手段が無く山一までご来店いただけないお客様には、ご自宅、入居施設、病院等に出張訪問をいたします。<br>お気軽にご相談ください。
// △メイン△
// ▽メイン▽
main.testRequestMain
    .pageKvPanel
        .pageKvTitle
            h1 濾過テストのご依頼
    .topicPath
        ol
            li
                a(href="") トップ
            li 濾過テストのご依頼
    .testRequestContainer
        .secWrap
            .secTitle
                p.subTitle REQUEST FOR FILTRATION TEST
                h2 濾過テストのご依頼
            .testRequestSection
                h3 濾過テストについて
                .testRequestSection__text
                    p 液種・菌種によって、濾過性は異なりますが、使用感も含めて、小型実験機で濾過テストをすることができます。<br>テスト結果から実機での濾過量予測試算を行うことができます。
                .introSection
                    h4 ２種類のテスト
                    .introPanel
                        dl
                            dt 濾過精度確認テスト
                            dd
                                p フィルターグレードを選定するため、濾過前後の粒度分布や濁度を測定することで確認します。
                        dl
                            dt 濾過流量確認テスト
                            dd
                                p 目詰まりを確認し、濾過面積を選定するため、目詰まりするまでの濾過量を測定します。
                .photoSection
                    h4 濾過テスト機
                    .photoPanel
                        .photoBox
                            p.ttl セラポア
                            ul
                                li
                                    img(src=(root_path || '') + "image/test_request/test_request_item_1_1.png", alt="")
                                li
                                    img(src=(root_path || '') + "image/test_request/test_request_item_1_2.png", alt="")
                        .photoBox
                            p.ttl 濾紙/濾布
                            ul
                                li
                                    img(src=(root_path || '') + "image/test_request/test_request_item_2_1.png", alt="")
                                li
                                    img(src=(root_path || '') + "image/test_request/test_request_item_2_2.png", alt="")
                        .photoBox
                            p.ttl １本立て
                            ul
                                li
                                    img(src=(root_path || '') + "image/test_request/test_request_item_3_1.png", alt="")
                                li
                                    img(src=(root_path || '') + "image/test_request/test_request_item_3_2.png", alt="")
                        .photoBox
                            p.ttl NF/HPF20
                            ul
                                li
                                    img(src=(root_path || '') + "image/test_request/test_request_item_4_1.png", alt="")
                                li
                                    img(src=(root_path || '') + "image/test_request/test_request_item_4_2.png", alt="")
// △メイン△
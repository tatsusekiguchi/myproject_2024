			video(src=(root_path || '') + "image/top/top_movie.mp4" autoplay="" loop="" muted="" playsinline="")
	#headLineContainer
		.secPanel
			.txtBox
				.inner
					.titleBox
						p.subTitle Our Mission
						h2 ロスイキの使命
					dl
						dt 人の生命・環境を支える精密濾過技術
						dd 高純度・無菌を目的とする精密濾過・水処理に関わるテクノロジー<br>一筋に歩んできたロスイキの製品・技術は高い信頼のもと、<br>幅広い業界に導入されています。

			.photo
				img(src=(root_path || '') + "image/top/head_img_01.png", alt="")
		.secPanel
			.txtBox
				.inner
					.titleBox
						p.subTitle Our Technical Skill
						h2 ロスイキの技術力
					dl
						dt 高い技術力と柔軟でフレキシブルなサービス
						dd 自社一貫体制のもと、専門分野に特化して得たものは、その分野に関する高い技術と深い知識です。これが当社の技術者一人ひとりにまで浸透し取引企業からのどんな依頼にもその場で対応、小回りのきくサービスを提供します。お客様が困った時に、ロスイキなら何とかしてくれる。それが技術者一人ひとりの技術力の高さの証でもあり、お客様の安心感にもつながります。
			.photo
				img(src=(root_path || '') + "image/top/head_img_02.png", alt="")

// ▽メイン▽
main.exampleMain
    .pageKvPanel
        .pageKvTitle
            h1 使用例（お困りごと）
    .topicPath
        ol
            li
                a(href="") トップ
            li 使用例（お困りごと）
    .exampleContainer
        .secWrap
            .secTitle
                p.subTitle USAGE EXAMPLE
                h2 使用例
            .exampleSection
                h3 ①菌を取り除きたい（目的：除菌）
                .innerSection
                    .flowPanel
                        .ttl
                            h4 納入先：酵素、バイオ、食品、飲料、水産試験場、水族館
                        dl
                            dt 〈フロー例〉
                            dd
                                .chart.chart01
                                    img(src=(root_path || '') + "image/example/flow_chart_01.png", alt="")
                            dd
                                p セラポアは高い濾過精度を有しており、除菌目的での使用例が多いです。<br>メンブレンと比較してブラッシング機能による経済効果が大きく、酵素製造工程(除菌工程)にて高いシェアを誇っています。<br>酵素の他にも、バイオ、食品、飲料、海水等の除菌濾過でも多数ご使用頂いています。<br>＊ブラッシング機能：目詰まりが発生した際に、フィルター表面をブラッシングし、目詰まり箇所を取り除く機能
                    .examplePanel
                        dl
                            dt 〈実例紹介〉
                            dd
                                .exampleList01
                                    ul
                                        li
                                            figure
                                                img(src=(root_path || '') + "image/example/example_list_1_1.png", alt="")
                                            figcaption 酵素液：濾過前
                                        li
                                            figure
                                                img(src=(root_path || '') + "image/example/example_list_1_2.png", alt="")
                                            figcaption 酵素液：濾過後
                    .relationPanel
                        dl
                            dt 〈関連濾過機〉
                            dd
                                .relationList
                                    ul
                                        li
                                            figure
                                                img(src=(root_path || '') + "image/example/relation_list_1_1.png", alt="")
                                            figcaption S シリーズ
                                        li
                                            figure
                                                img(src=(root_path || '') + "image/example/relation_list_1_2.png", alt="")
                                            figcaption SA シリーズ
                                        li
                                            figure
                                                img(src=(root_path || '') + "image/example/relation_list_1_3.png", alt="")
                                            figcaption PS シリーズ
            .exampleSection
                h3 ②濁りを取りたい（目的：除濁、清澄化）
                .innerSection
                    .flowPanel
                        .ttl
                            h4 納入先：香料、化粧品、飲料、ワイン、化学
                        dl
                            dt 〈フロー例〉
                            dd
                                .chart.chart02
                                    img(src=(root_path || '') + "image/example/flow_chart_02.png", alt="")
                            dd
                                p 濁りを取り除き、清澄化させる目的で濾過機を使用することが多いです。<br>香料メーカーなどでは、濾紙と濾過助剤を組み合わせることで、液中の濁度成分を取り除いています。<br>濁り成分の粒子の大きさによっては、濾紙では除濁ができない場合もあります。<br>セラポアの場合は、濾紙よりも濾過精度が高いことから、濾過助剤を使用せず、ワンパスで除濁できるケースが多いです。<br>求める清澄度合いによって、セラポアの濾過精度を選択することができます。
                    .examplePanel
                        dl
                            dt 〈実例紹介〉
                            dd
                                .exampleList02
                                    ul
                                        li
                                            figure
                                                img(src=(root_path || '') + "image/example/example_list_2_1.png", alt="")
                                            figcaption 白ワイン：濾過前
                                        li
                                            figure
                                                img(src=(root_path || '') + "image/example/example_list_2_2.png", alt="")
                                            figcaption 白ワイン：濾過後
                                        li
                                            figure
                                                img(src=(root_path || '') + "image/example/example_list_2_3.png", alt="")
                                            figcaption 香料：濾過前
                                        li
                                            figure
                                                img(src=(root_path || '') + "image/example/example_list_2_4.png", alt="")
                                            figcaption 香料：濾過後
                    .relationPanel
                        dl
                            dt 〈関連濾過機〉
                            dd
                                .relationList
                                    ul
                                        li
                                            figure
                                                img(src=(root_path || '') + "image/example/relation_list_2_1.png", alt="")
                                            figcaption S シリーズ
                                        li
                                            figure
                                                img(src=(root_path || '') + "image/example/relation_list_2_2.png", alt="")
                                            figcaption SA シリーズ
                                        li
                                            figure
                                                img(src=(root_path || '') + "image/example/relation_list_2_3.png", alt="")
                                            figcaption NF/HPF シリーズ
            .exampleSection
                h3 ③異物・不純物を取りたい
                .innerSection
                    .flowPanel
                        .ttl
                            h4 納入先：ベアリング、RO の前処理、化学
                        dl
                            dt 〈フロー例〉
                            dd
                                .chart.chart03
                                    img(src=(root_path || '') + "image/example/flow_chart_03.png", alt="")
                            dd
                                p ベアリング加工時の洗浄油濾過では、プレコート濾過機が使用されています。<br>高い清浄度を実現できる為、製品の品質向上と洗浄油の長寿命化の効果があります。<br>また、セラポアはROの前処理としても使用頂いています。<br>セラポア濾過によりFI値を下げることができる為、RO膜の延命化に繋がります。
                    .examplePanel
                        dl
                            dt 〈実例紹介〉
                            dd
                                .exampleList02
                                    ul
                                        li
                                            figure
                                                img(src=(root_path || '') + "image/example/example_list_3_1.png", alt="")
                                            figcaption CF 濾過機の様子
                                        li
                                            figure
                                                img(src=(root_path || '') + "image/example/example_list_3_2.png", alt="")
                                            figcaption CF 濾過機の様子
                    .relationPanel
                        dl
                            dt 〈関連濾過機〉
                            dd
                                .relationList
                                    ul
                                        li
                                            figure
                                                img(src=(root_path || '') + "image/example/relation_list_3_1.png", alt="")
                                            figcaption CF 濾過機
                                        li
                                            figure
                                                img(src=(root_path || '') + "image/example/relation_list_3_2.png", alt="")
                                            figcaption S シリーズ
                                        li
                                            figure
                                                img(src=(root_path || '') + "image/example/relation_list_3_3.png", alt="")
                                            figcaption SA シリーズ
            .exampleSection
                h3 ④活性炭を取り除きたい
                .innerSection
                    .flowPanel
                        .ttl
                            h4 納入先：飲料用水、化粧品、化学
                        dl
                            dt 〈フロー例〉
                            dd
                                .chart.chart04
                                    img(src=(root_path || '') + "image/example/flow_chart_04.png", alt="")
                            dd
                                p 清涼飲料水向けの水からの異物と塩素除去のために活性炭濾過を行っています。<br>逆洗により繰り返しの使用が可能な為、ランニングコストを低く抑えることが可能です。<br>また、製品の脱色目的で原液に活性炭を混合させた後での濾過を行っています。<br>水平濾板型濾過機では、捕捉した活性炭の回収が容易です。
                    .examplePanel
                        dl
                            dt 〈実例紹介〉
                            dd
                                .beforeAfterPanel
                                    .beforeAfterBox
                                        ul
                                            li
                                                img(src=(root_path || '') + "image/example/example_list_4_1.png", alt="")
                                            li
                                                img(src=(root_path || '') + "image/example/example_list_4_2.png", alt="")
                                        p CF 濾過機での活性炭除去の様子
                                    .beforeAfterBox
                                        ul
                                            li
                                                img(src=(root_path || '') + "image/example/example_list_4_3.png", alt="")
                                            li
                                                img(src=(root_path || '') + "image/example/example_list_4_4.png", alt="")
                                        p セラホワイトを使用した活性炭除去の様子
                                    .beforeAfterBox
                                        ul
                                            li
                                                img(src=(root_path || '') + "image/example/example_list_4_5.png", alt="")
                                            li
                                                img(src=(root_path || '') + "image/example/example_list_4_6.png", alt="")
                                        p 濾紙濾過機での活性炭除去の様子

                    .relationPanel
                        dl
                            dt 〈関連濾過機〉
                            dd
                                .relationList
                                    ul.col4
                                        li
                                            figure
                                                img(src=(root_path || '') + "image/example/relation_list_4_1.png", alt="")
                                            figcaption CF 濾過機
                                        li
                                            figure
                                                img(src=(root_path || '') + "image/example/relation_list_4_2.png", alt="")
                                            figcaption NF/HPF シリーズ
                                        li
                                            figure
                                                img(src=(root_path || '') + "image/example/relation_list_4_3.png", alt="")
                                            figcaption S シリーズ
                                        li
                                            figure
                                                img(src=(root_path || '') + "image/example/relation_list_4_4.png", alt="")
                                            figcaption SA シリーズ
            .exampleSection
                h3 ⑤結晶を回収したい
                .innerSection
                    .flowPanel
                        .ttl
                            h4 納入先：化学
                        dl
                            dt 〈フロー例〉
                            dd
                                .chart.chart05
                                    img(src=(root_path || '') + "image/example/flow_chart_05.png", alt="")
                            dd
                                p 化学メーカーでは、反応物の濾過を行い、結晶物の回収目的で濾過を行うことがあります。<br>バッチ量に合わせて濾過面積を選択することが可能であり、単板型のHPFタイプでは、結晶物の回収を固形の状態で容易に行うことが可能です。
                    .examplePanel
                        dl
                            dt 〈実例紹介〉
                            dd
                                .exampleList02
                                    ul
                                        li
                                            figure
                                                img(src=(root_path || '') + "image/example/example_list_5_1.png", alt="")
                                            figcaption 結晶回収の様子
                    .relationPanel
                        dl
                            dt 〈関連濾過機〉
                            dd
                                .relationList
                                    ul

// ▽メイン▽
main.historyMain
    .pageKvPanel
        .pageKvTitle
            h1 沿革
    .topicPath
        ol
            li
                a(href="") トップ
            li 沿革
    .historyContainer
        .secWrap
            .secTitle
                p.subTitle HISTORY
                h2 沿革
            .historySection
                h3 ロスイキの歴史
                .historyList
                    ol
                        li
                            dl
                                dt
                                    span 大正7年
                                dd
                                    .txt
                                        p 素焼濾過筒（セラポア）製造方法を発明。生産並びに販売を始める。
                        li
                            dl
                                dt
                                    span 昭和17年
                                dd
                                    .txt
                                        p 株式会社に組織変更。
                        li
                            dl
                                dt
                                    span 昭和22年
                                dd
                                    .txt
                                        p 一般民需用の濾過筒製作を再開し、新たに精密濾過機製作を開始。
                                    .photoList
                                        ul
                                            li
                                                figure
                                                    img(src=(root_path || '') + "image/history/history_list_item_01.png", alt="")
                                                figcaption 鋳鉄製 飴用濾過機
                                            li
                                                figure
                                                    img(src=(root_path || '') + "image/history/history_list_item_02.png", alt="")
                                                figcaption 当時のNo.8
                                            li
                                                figure
                                                    img(src=(root_path || '') + "image/history/history_list_item_03.png", alt="")
                                                figcaption 当時の機械工場
                        li
                            dl
                                dt
                                    span 昭和28年
                                dd
                                    .txt
                                        p 厚生省より災害用濾水機として指定され各都道府県に採用される。
                                    .photoList
                                        ul
                                            li
                                                figure
                                                    img(src=(root_path || '') + "image/history/history_list_item_04.png", alt="")
                                                figcaption A型災害
                                            li
                                                figure
                                                    img(src=(root_path || '') + "image/history/history_list_item_05.png", alt="")
                                                figcaption 警察型
                                            li
                                                figure
                                                    img(src=(root_path || '') + "image/history/history_list_item_06.png", alt="")
                        li
                            dl
                                dt
                                    span 昭和32年
                                dd
                                    .txt
                                        p ビルマ国防省に車載用大型精密濾過機を多数納入。
                        li
                            dl
                                dt
                                    span 昭和34年
                                dd
                                    .txt
                                        p 平板型濾過機ニューフィルター開発。
                        li
                            dl
                                dt
                                    span 昭和39年
                                dd
                                    .txt
                                        p 新工場落成。名古屋出張所開設。／セラマック筒開発。
                        li
                            dl
                                dt
                                    span 昭和40年
                                dd
                                    .txt
                                        p 大型自動洗浄式セラポア濾過機（S-83型及びS-86型）完成。純水機など総合水処理業務拡張。
                        li
                            dl
                                dt
                                    span 昭和42年
                                dd
                                    .txt
                                        p 医薬用水製造ラインをシステム化、基幹業務に。更に清涼飲料用水製造プラントを手掛ける。
                        li
                            dl
                                dt
                                    span 昭和43年
                                dd
                                    .txt
                                        p 創業50周年を迎える。所轄税務署管内第一号優良申告法人表彰を受ける。
                        li
                            dl
                                dt
                                    span 昭和44年
                                dd
                                    .txt
                                        p 災害用濾水機新型開発。神奈川県他に大々的に
                        li
                            dl
                                dt
                                    span 昭和46年
                                dd
                                    .txt
                                        p 静岡出張所開設。<br>画期的濾材活性炭セラポア、<br>活性シャンベランの製造方法の発明。
                                    .photoList
                                        ul
                                            li
                                                figure
                                                    img(src=(root_path || '') + "image/history/history_list_item_07.png", alt="")
                                                figcaption 濾材活性炭セラポア、<br>活性シャンベラン
                        li
                            dl
                                dt
                                    span 昭和47年
                                dd
                                    .txt
                                        p 資本金4600万円へ。／酵素液無菌濾過機をブルガリアへ輸出。
                        li
                            dl
                                dt
                                    span 昭和48年
                                dd
                                    .txt
                                        p 本社ビル新築完成。
                        li
                            dl
                                dt
                                    span 昭和49年
                                dd
                                    .txt
                                        p 缶ジュース用水製造プラント各県経済連へ納入。<br>業務処理にコンピューター導入。
                        li
                            dl
                                dt
                                    span 昭和50年
                                dd
                                    .txt
                                        p 製薬GMP適合関連機器発表。
                        li
                            dl
                                dt
                                    span 昭和51年
                                dd
                                    .txt
                                        p ダウケミカル社と逆浸透膜代理店契約、膜利用分野に本格進出。<br>更に同社とイオン交換樹脂代理店契約。
                        li
                            dl
                                dt
                                    span 昭和52年
                                dd
                                    .txt
                                        p 米国アクアケム社蒸留機代理店契約、以降技術契約へ移行し国産化へ。昭和54年
                        li
                            dl
                                dt
                                    span 昭和56年
                                dd
                                    .txt
                                        p 富士電機と提携、オゾン殺菌システムを共同開発。
                                    .photoList
                                        ul
                                            li
                                                figure
                                                    img(src=(root_path || '') + "image/history/history_list_item_08.png", alt="")
                                                figcaption オゾン殺菌システム
                        li
                            dl
                                dt
                                    span 昭和60年
                                dd
                                    .txt
                                        p UFによる脱パイロジェンシステム本格化。
                        li
                            dl
                                dt
                                    span 昭和61年
                                dd
                                    .txt
                                        p エンジニアリングプラスティックによる<br>新型セラポア濾過機PSシリーズ発表、<br>養殖場、水産試験場など海水無菌濾過に適合。
                                    .photoList
                                        ul
                                            li
                                                figure
                                                    img(src=(root_path || '') + "image/history/history_list_item_09.png", alt="")
                                                figcaption PSシリーズ
                        li
                            dl
                                dt
                                    span 昭和62年
                                dd
                                    .txt
                                        p CAD設計システム導入。／ダブルチューブシート式熱交換器本格発表、バリデーションに先駆ける。
                        li
                            dl
                                dt
                                    span 昭和63年
                                dd
                                    .txt
                                        p 創業70周年を迎える。
                        li
                            dl
                                dt
                                    span 平成2年
                                dd
                                    .txt
                                        p 有名ブランドドリンク用設備のほとんどを当社設備で納入施工。
                        li
                            dl
                                dt
                                    span 平成3年
                                dd
                                    .txt
                                        p 真珠養殖用海水濾過装置続々受注。
                        li
                            dl
                                dt
                                    span 平成5年
                                dd
                                    .txt
                                        p セラポア加工用ロボット操作の特殊自動旋盤装置設置。<br>組立配管自動溶接機の設置。
                        li
                            dl
                                dt
                                    span 平成7年
                                dd
                                    .txt
                                        p プラントエンジニアリング営業所開設。
                        li
                            dl
                                dt
                                    span 平成8年
                                dd
                                    .txt
                                        p セラポア製造用原料配合自動計量攪拌設備を自社開発設置。
                        li
                            dl
                                dt
                                    span 平成9年
                                dd
                                    .txt
                                        p CAD大幅更新増設並びにLANで連結。
                        li
                            dl
                                dt
                                    span 平成10年
                                dd
                                    .txt
                                        p 連続30年優良申告法人表彰を受ける。／中国、エクアドル、ベトナムへ輸出。
                        li
                            dl
                                dt
                                    span 平成11年
                                dd
                                    .txt
                                        p 旭硝子と提携、電気再生純水装置E-CELLを自社開発。<br>新コンピューターシステム導入、<br>富士通GLOVIA第一号ユーザーとして販売業務全社オンライン化。
                                    .photoList
                                        ul
                                            li
                                                figure
                                                    img(src=(root_path || '') + "image/history/history_list_item_10.png", alt="")
                                                figcaption 電気再生純水装置（EDI）
                        li
                            dl
                                dt
                                    span 平成13年
                                dd
                                    .txt
                                        p デンマークKEMITERM社提携、蒸留機、ピュアースチーム発生機を製薬用水の中核とする。
                        li
                            dl
                                dt
                                    span 平成14年
                                dd
                                    .txt
                                        p スウェーデンGETINGE社滅菌機、洗浄機の販売権を得て営業品目拡大。
                        li
                            dl
                                dt
                                    span 平成15年
                                dd
                                    .txt
                                        p 創立85周年、連続8回目の優良申告法人表彰を受ける。
                        li
                            dl
                                dt
                                    span 平成19年
                                dd
                                    .txt
                                        p バイオ医薬向けRO、UF、WFI装置を納入。
                        li
                            dl
                                dt
                                    span 平成23年
                                dd
                                    .txt
                                        p アブダビ世界未来エネルギーサミット（World Future Energy Summit）に災害用（移動式）濾過機を出展

// △メイン△
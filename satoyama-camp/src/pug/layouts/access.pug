        .pageKvPanel
            .pageKvTitle
                h1 アクセス
    .pageLogoBox
        .logo
            img(src=(root_path || '') + "image/common/header_logo.png", alt="")
    .sec01
        .secWrap
            .pageSecTtlBox
                h2
                    em ア
                    | クセス
            .secContainer
                .cntInner
                    .message

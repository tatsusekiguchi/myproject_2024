						<script src="https://www.sototenki.jp/widget/widget.php?id=456435&auto=1"></script>
						<div id="COURSE_WRAPPER"><div class="COURSE_WIDGET"><div id="COURSE_WIDGET_AUTO"></div></div></div>
						<script>render_widget('COURSE_WIDGET_AUTO','COURSE_WRAPPER', 580);</script>
					</div>

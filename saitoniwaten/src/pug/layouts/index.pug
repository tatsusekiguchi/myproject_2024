                                img(src="https://saitoniwaten240821.smooooth.jp/system_panel/uploads/images/top_sec02_img_02.png", alt="")
                            .txtBox
                                .ttl01
                                     p KADOMATSU
                                .ttl02
                                    p 門松販売
                                .btnMoreWhite
                                    p 詳しく見る

script.
    var itemsPerPage = 9;  // 1ページあたりのアイテム数
    var $items = $(".listBox li");  // 全リストアイテム
    var totalItems = $items.length;  // アイテムの総数
    var totalPages = Math.ceil(totalItems / itemsPerPage);  // 総ページ数

    // 初期表示は1ページ目
    var currentPage = 1;

    // アイテムをページに応じて表示する関数
    function showPage(page) {
        // ページに対応する範囲のアイテムを表示
        $items.hide();
        var start = (page - 1) * itemsPerPage;
        var end = start + itemsPerPage;
        $items.slice(start, end).show();

        // ページネーションの更新
        $(".pagination").html(createPagination(page));
    }

    // ページネーションのHTMLを生成する関数
    function createPagination(page) {
        var paginationHtml = '';

        // 「最初」「前」ボタン
        if (page > 1) {
            paginationHtml += '<li class="first"><a href="#" data-page="1"></a></li>';
            paginationHtml += '<li class="previous"><a href="#" data-page="' + (page - 1) + '"></a></li>';
        }

        // 各ページのリンク
        for (var i = 1; i <= totalPages; i++) {
            if (i === page) {
                paginationHtml += '<li class="current"><a>' + i + '</a></li>';
            } else {
                paginationHtml += '<li><a href="#" class="inactive" data-page="' + i + '">' + i + '</a></li>';
            }
        }

        // 「次」「最後」ボタン
        if (page < totalPages) {
            paginationHtml += '<li class="next"><a href="#" data-page="' + (page + 1) + '"></a></li>';
            paginationHtml += '<li class="last"><a href="#" data-page="' + totalPages + '"></a></li>';
        }

        return paginationHtml;
    }

    // ページネーションのクリックイベント
    $(document).on("click", ".pagination a", function(e) {
        e.preventDefault();
        var page = $(this).data("page");
        if (page) {
            currentPage = page;
            showPage(currentPage);

            // ページ遷移後に#sec01へスクロール
            $('html, body').animate({
                scrollTop: $('#sec01').offset().top
            }, 500);  // 500msでスムーズにスクロール
        }
    });

    // 初期化
    showPage(currentPage);  // 最初のページを表示

            .contactForm
                form(data-formtype="1" method="post" action="contactComplete" name="form").form
                    .formBox
                        .dl
                            .dt
                                p.span お名前
                                p.em 必須
                            .dd
                                input(type="text" class="name" name="お名前" placeholder="例）みつる　太朗" data-displaynameattr="お名前").validateRequired
                        .dl
                            .dt
                                p.span ふりがな
                                p.em 必須
                            .dd
                                input(type="text" class="kana" name="ふりがな" placeholder="例）みつる　たろう" data-displaynameattr="ふりがな").validateHiragana1
                        .dl
                            .dt
                                p.span 郵便番号
                                p.em 必須
                            .dd
                                .postalBox

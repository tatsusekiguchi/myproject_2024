                    .li
                        img(src="https://shitok.jp/system_panel/uploads/images/top_sec04_icon_03.png", alt="")
                    .li
                        img(src="https://shitok.jp/system_panel/uploads/images/top_sec04_icon_04.png", alt="")
                    .li
                        img(src="https://shitok.jp/system_panel/uploads/images/top_sec04_icon_05.png", alt="")

// ▽メイン▽
.topMain.main
    .topKvContainer
        .topKvPanel
            .kvTtlBox
                .kvTtl
                    img(src="https://shitok.jp/system_panel/uploads/images/top_kv_title.png", alt="")
                .kvContact
                    a(href="contact")
                        div
                            img(src="https://shitok.jp/system_panel/uploads/images/top_kv_contact.png", alt="")
            .btnImg
                img(src="https://shitok.jp/system_panel/uploads/images/top_kv_btm_img.png", alt="")
    .sec01
        .secWrap01
            .pageSecTtlBox.fadeUp
                .pageSecTtl
                    h2 「空き家」に関するお悩みありませんか？
                .sub
                    p WORRY
            .secBox
                .checkTxt.fadeUp
                    .ul
                        .li
                            p 親から家を相続したけど、どうしたらいいか分からない。
                        .li
                            p 空き家について考えたいけど、何からしたらいいのか。
                        .li
                            p 空き家について信頼できる会社に相談したい。
                        .li
                            p 空き家の管理が大変で、どうにかしたい。
                        .li
                            p 空き家が売れるのか、借りたい人がいるのか、分からない。
                        .li
                            p 周辺が空き家になってきたので、そろそろどうにかしなければ。
            .balloon.fadeUp
                img(src="https://shitok.jp/system_panel/uploads/images/top_sec01_balloon.png", alt="")
            .txtBox.fadeUp
                .txt
                    p Office TMKは
                    p.em 空き家のご相談を無料
                    p で受け付けております。
                .txt
                    p 空き家管理や相談、活用、販売など、一度にお問い合わせください。
    .sec02
        .pageSecTtlBox.fadeUp
            .pageSecTtl
                h2 Office TMKの強み
            .sub
                p STRENGTH
        .secPanelList
            .secPanel
                .photo
                    img(src="https://shitok.jp/system_panel/uploads/images/top_sec02_img_01.png", alt="")
                .secBox.fadeUp
                    .txtBox
                        .ttlBg
                            img(src="https://shitok.jp/system_panel/uploads/images/top_sec02_ttl_01.png", alt="")
                        .inner
                            .ttl
                                p 専門家チームによる
                                p.em 最適な提案
                            .txt
                                p Office TMKは専門家チームで空き家問題に取り組んでいます。
                            .txt
                                p.em 弁護士、司法書士、行政書士、土地家屋調査士
                                p などその道のプロが対応。
                            .txt
                                p 丁寧なヒアリングで、お客様に寄り添った提案を致します。
            .secPanel
                .photo
                    img(src="https://shitok.jp/system_panel/uploads/images/top_sec02_img_02.png", alt="")
                .secBox.fadeUp
                    .txtBox
                        .ttlBg
                            img(src="https://shitok.jp/system_panel/uploads/images/top_sec02_ttl_02.png", alt="")
                        .inner
                            .ttl
                                p 地域密着の
                                p.em 情報力
                                p と寄り添った相談
                            .txt
                                p Office TMKは菊川市を中心に周辺地域までご相談に乗っております。
                            .txt
                                p 地域密着のため、
                                p.em 地元での情報収集も得意
                                p としております。
                            .txt
                                p またお客様の状況に
                                p.em 寄り添った相談や対応
                                p もご好評いただいております。
        .btnMore
            a(href="strength")
                div
                    p 詳しく見る
    .sec03
        .pageSecTtlBox.fadeUp
            .pageSecTtl
                h2 事業紹介
            .sub
                p BUSINESS
        .secPanel
            .photo
                img(src="https://shitok.jp/system_panel/uploads/images/top_sec03_img_01.png", alt="")
            .txtBox.fadeUp
                .inner
                    .ttlBox
                        .ttl
                            p 空き家対策事業、不動産仲介、
                        .ttl
                            p 事業用地取引など
                            p.em 幅広く対応
                    .txt
                        p 静岡県菊川市周辺の空き家に関しては、Office TMKにお任せ下さい。<br>また不動産仲介や事業用地取引など、幅広く業務を行っております。<br>事業用地取引は全国対応しているので、お探しの方は一度ご連絡ください。
                    .btnMore
                        a(href="business")
                            div
                                p 詳しく見る

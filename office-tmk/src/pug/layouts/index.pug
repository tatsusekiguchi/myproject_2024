                .photo
                    img(src="https://shitok.jp/system_panel/uploads/images/top_sec06_img_01.png", alt="")
                .secBox.fadeUp
                    .txtBox
                        .ttlBg
                            img(src="https://shitok.jp/system_panel/uploads/images/top_sec06_ttl_01.png", alt="")

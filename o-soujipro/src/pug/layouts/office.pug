// ▽メイン▽
main#office
	.pageKvContainer
		.pageKvPanel
			.pageKvTitle
				h1 オフィス清掃
	.sec01
		.secWrap01
			.pageSecTitleBox
				.pageSecTitle
					h2 オフィス清掃のお悩みありませんか？
			.topTxt
				.txt
					p 毎日多くの時間を過ごすオフィスをクリーンに保ち続けるには適切な清掃が必要です。<br>ご自身で清掃を行うには適切な道具や洗剤の準備が必要ですし、清掃を行う時間も必要です。<br>すでに業者に清掃を委託している場合でも、清掃のレベルを上げてほしい、月額の金額が安くならないかなどのお悩みをよく耳にします。<br>そういったお悩みがありましたら、お任せください。確かな品質とノウハウで皆様が毎日気持ちよくお仕事ができる環境を整えます
	.sec02
		.secWrap02
			.secTitleBox
				h2 オフィス清掃項目
			.listBox
				ul
					li
						.photo
							img(src=(root_path || '') + "image/office/office_sec02_photo_01.png", alt="")
						dl
							dt フロア清掃
							dd ハードフロアの場合は人が通るたびにホコリが舞いますので、こまめにモップ掛けを行う必要があります。カーペットフロアでしたら、カーペットがホコリを抱き込むので、そのホコリを掃除機で吸い取ります。
					li
						.photo
							img(src=(root_path || '') + "image/office/office_sec02_photo_02.png", alt="")
						dl
							dt テーブル拭き掃除
							dd テーブルは指紋が一番つきやすい場所です。そのままにしておくと黒ずみができてしまいますので、除菌剤で定期的に拭いて取り除きます。
					li
						.photo
							img(src=(root_path || '') + "image/office/office_sec02_photo_03.png", alt="")
						dl
							dt トイレ清掃
							dd トイレを清掃する際は必ず「ピンクのタオル」で行います。トイレ清掃で使用したタオルを他の清掃に使用することを防ぐためです。アンモニアなどの汚れを他の場所にうつすことの無いよう、注意を払っています。
					li
						.photo
							img(src=(root_path || '') + "image/office/office_sec02_photo_04.png", alt="")
						dl
							dt ゴミ清掃・収集
							dd デスク横のゴミ箱のゴミ回収から搬出場所までの運搬までを行います。
					li
						.photo
							img(src=(root_path || '') + "image/office/office_sec02_photo_05.png", alt="")
						dl
							dt 玄関ドア吹きあげ
							dd 玄関は会社の顔です。取っ手やガラスに付きやすい指紋を拭きとることにより清潔感が出てきます。
					li
						.photo
							img(src=(root_path || '') + "image/office/office_sec02_photo_06.png", alt="")
						dl
							dt 受話器の除菌清掃
							dd 一見汚れていない受話器は実は雑菌の繁殖場所。日々の使用で見えない汚れが付きやすいところです。除菌剤で適切に拭きとることで皆様の健康にも貢献します。
			.planPanel
				h3 料金プラン
				.setPanel
					.ttlBox
						h4 週1プラン
						p 16,500円（税込）
					.setBox
						dl
							dt 広さ目安50㎡～&nbsp;人数目安5人〜
							dd スタッフが10名以下のオフィス、50㎡くらいの広さのオフィスに適したプランです。
				.setPanel
					.ttlBox
						h4 週2プラン
						p 25,300円（税込）
					.setBox
						dl
							dt 広さ目安80㎡～&nbsp;人数目安10人〜
							dd スタッフが10名以下のオフィス、50㎡くらいの広さのオフィスに適したプランです。
				.setPanel
					.ttlBox
						h4 週3プラン
						p 35,750円（税込）
					.setBox
						dl
							dt 広さ目安100㎡～&nbsp;人数目安15人〜
							dd 曜日ごとに清掃場所を変えて、場所ごとに徹底的に綺麗にするお客様の多いプランです。
				.setPanel
					.ttlBox
						h4 週4プラン
						p 46,750円（税込）
					.setBox
						dl
							dt 広さ目安100㎡～&nbsp;人数目安20人〜
							dd ごみの収集日に合わせて清掃に入るプランとして最適です。
				.setPanel
					.ttlBox
						h4 週5プラン
						p 60,500円（税込）
					.setBox
						dl
							dt 広さ目安200㎡～&nbsp;人数目安30人〜
							dd 平日毎日清掃に入ることでゴミ箱のゴミがたまることもなく、常に清潔な環境を保つことが可能です。
// △メイン△
                    .li
                        .ba02
                            .photoBox01.photoBox
                                .ttl01.ttl
                                    p 施工前
                                .photo
                                    img(src="https://recelljapan240116.smooooth.jp/system_panel/uploads/images/repair_sec02_list_06.png", alt="")

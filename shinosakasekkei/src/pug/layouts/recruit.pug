                                .dd
                                    input(type="text" class="kana" name="ふりがな" placeholder="例）やまだ　はなこ" data-displaynameattr="ふりがな").validateHiragana1
                            //- .dl
                            //-     .dt
                            //-         p.span 住所
                            //-         p.em 必須
                            //-     .dd

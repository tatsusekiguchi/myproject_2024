// ▽メイン▽
.recruitMain.main
    .pageKv
        .kvArea
            .kvTtl
                p RECRUIT
                h1 採用情報
    .sec01.fadeUp
        .secBox01
            .secWrap02
                .light
                .secTtl
                    p MESSAGE
                    h2 メッセージ
                .subTtl
                    h3 仕事を通して、自分のファンを増やす
                .img
                    img(src="https://sanden-service210719.smooooth.jp/system_panel/uploads/images/top_sec01_img.png", alt="")
        .secBox02
            .secWrap02
                .txt
                    p 見えないものが伝えることができたとき、人は人に魅力を感じます。<br>例えば誠実な態度や感謝の気持ち、驚きや感動であったり。<br>こういった見えない思いを提供できた時に、初めて人はその人のファンになります。<br>自分のファンを増やすと、生活がより充実していきます。<br>では、どうすればファンが増えるのでしょうか。<br>まずは、自分が自分のファンであること。<br>そして、誰よりも「自分」をよく知っているということ。<br>つまり自らを知り、強みや弱みさえ魅力と感じさせることができる人は<br>周りを巻き込みながらファンを増やすことができます。<br>それができる人は仕事も上手く回り、やりがいもでてきます。<br>ファンを作りあえるような温かい職場で一緒に働きませんか？
    .sec02.fadeUp
        .light
        .secWrap01
            .secTtl
                p WORKING
                h2 WORKING
            .ul
                .li
                    .num
                        img(src="https://sanden-service210719.smooooth.jp/system_panel/uploads/images/recruit_sec02_num_01.png", alt="")
                    .dl
                        .dt
                            p 常に前を向いて<br>行動できる
                        .dd
                            p 失敗しても構いません。「この失敗を自分が成長するきっかけにしよう」と捉え、前を向いて好奇心を持って動ける方は向ています。積極的にチャレンジする気持ちが、自分自身を成長させます。
                .li
                    .num
                        img(src="https://sanden-service210719.smooooth.jp/system_panel/uploads/images/recruit_sec02_num_02.png", alt="")
                    .dl
                        .dt
                            p なんでだろう？<br>と探求する心がある
                        .dd
                            p 疑問に持ったら自分が納得するまで掘り下げれる方は向いています。自分の分からないことをそのままにせず、理解しようとする姿勢のある方が当てはまります。
                .li
                    .num
                        img(src="https://sanden-service210719.smooooth.jp/system_panel/uploads/images/recruit_sec02_num_03.png", alt="")
                    .dl
                        .dt
                            p 他者を尊重し、<br>信頼を大切にする
                        .dd
                            p 良い人間関係は、良い仕事を生みます。チームワークを大切に、相手を理解しようと努めれる方は向いています。信頼力は、気兼ねなく質問やお互いの仕事のフォローができる環境を作ります。
    .sec03.fadeUp
        .light
        .secWrap02
            .secTtl
                p FLOW
                h2 採用までの流れ
            .ul
                .li
                    .num
                        p 01
                    .txt
                        p エントリー
                .li
                    .num
                        p 02
                    .txt
                        p 会社説明会
                .li
                    .num
                        p 03
                    .txt
                        p 書類選考
                .li
                    .num
                        p 04
                    .txt
                        p 面接
                .li
                    .num
                        p 05
                    .txt
                        p 内定
    .sec04.fadeUp
        .light
        .secWrap01
            .secTtl
                p REQUIREMENTS
                h2 募集要項
            .infoBox
                .dl
                    .dt
                        p 募集職種
                    .dd
                        p 総合技術職
                .dl
                    .dt
                        p 雇用形態
                    .dd
                        p 正社員　※試用期間：３か月
                .dl
                    .dt
                        p 勤務時間
                    .dd
                        p 9:00～17:30　※1年単位の変形労働採用
                .dl
                    .dt
                        p 条件
                    .dd
                        p 未経験者歓迎<br>普通自動車免許（MT）　※入社後の取得OK<br>学歴・年齢不問
                .dl
                    .dt
                        p 仕事内容
                    .dd
                        p 非常用電源の点検整備、試験調整
                .dl
                    .dt
                        p 勤務地
                    .dd
                        p 千葉県
                .dl
                    .dt
                        p 給与
                    .dd
                        p 大卒　222,120円（固定残業代40時間、52,120円を含む）<br>短大卒、高専卒、専門学校卒212,120円（ 固定残業代40時間、52,120円を含む）<br>院了・既卒　232,120円(固定残業代40時間、52,120円を含む）<br>※超過分は別途支給<br>昇給：年１回　賞与：年3回（※前年度　計５か月分）
                .dl
                    .dt
                        p 休日
                    .dd
                        p 年間休日数108日<br>隔週休2日制（日、隔土）<br>祝日 夏季 年末年始
                .dl
                    .dt
                        p 待　遇<br>福利厚生
                    .dd
                        p リフレッシュ休暇制度<br>職場積立NISA（奨励金あり）<br>保養施設利用可<br>社員旅行<br>退職金制度
                .dl
                    .dt
                        p 諸手当
                    .dd
                        p 交通費<br>夜勤手当（6,000円「夜勤を1回行った場合」）<br>休日（6,000円/1日）<br>家族手当（配偶者20,000円、子10,000円）<br>独立生計手当（20,000円）<br>資格手当
                .dl
                    .dt
                        p 研修制度
                    .dd
                        p 資格取得支援制度<br>メーカー技術研修制度<br>新人研修（外部講師委託）<br>フォローアップ研修<br>OJT研修
    .sec05.fadeUp
        .light
        .secWrap01
            .secTtl
                p ENTRY
                h2 応募フォーム
            p 下記の応募フォームより、ご応募ください。<br>必要事項を記入の上【応募する】ボタンをクリック下さい。
            .contactForm
                form(data-formtype="1" method="post").form
                    .formBox
                        .dl
                            .dt
                                p.span お名前
                                p.em 必須
                            .dd
                                input(type="text" class="name" name="name" placeholder="例） サンデン　太郎" data-displaynameattr="お名前" required)
                        .dl
                            .dt
                                p.span ふりがな
                                p.em 必須
                            .dd
                                input(type="text" class="kana" name="kana" placeholder="例） さんでん　たろう" data-displaynameattr="ふりがな" required)
                        .dl
                            .dt
                                p.span 生年月日
                                p.em 必須
                            .dd
                                .selectBox
                                    select(name="year" data-displaynameattr="生年月日(年)")
                                        option(value="") 年
                                        - for (var x = 1960; x < 2021; x++)
                                            option(value=x) #{x}
                                .selectBox
                                    select(name="month" data-displaynameattr="生年月日(月)")
                                        option(value="") 月
                                        - for (var x = 1; x < 13; x++)
                                            option(value=x) #{x}
                                .selectBox
                                    select(name="day" data-displaynameattr="生年月日(日)")
                                        option(value="") 日
                                        - for (var x = 1; x < 32; x++)
                                            option(value=x) #{x}
                        .dl.postal
                            .dt
                                p.span 郵便番号
                                p.em 必須
                            .dd
                                p.postalTxt 〒
                                input(type="text" class="postal_01 zip1" name="postal_01" placeholder="284" data-displaynameattr="郵便番号上3桁" required)
                                p.span -
                                input(type="text" class="postal_02 zip2" name="postal_02" placeholder="0015" data-displaynameattr="郵便番号下4桁" required)
                        .dl
                            .dt
                                p.span 住所
                                p.em 必須
                            .dd
                                input(type="text" class="address01" name="address01" placeholder="千葉県四街道市千代田4-45-14" data-displaynameattr="住所" required)
                        .dl
                            .dt
                                p.span 電話番号
                                p.em 必須
                            .dd
                                input(type="tel" class="tel" name="tel" placeholder="例） 043-423-5901" data-displaynameattr="電話番号" required)
                        .dl
                            .dt
                                p.span メールアドレス
                                p.em 必須
                            .dd
                                input(type="email" class="mail" name="mail" placeholder="例）sanden＠com" data-displaynameattr="メールアドレス" required)
                        .dl
                            .dt
                                p.span 確認用メールアドレス
                                p.em 必須
                            .dd
                                input(type="email" class="mailConfirm" name="mailConfirm" placeholder="確認のため再度お願いいたします。" data-displaynameattr="確認用メールアドレス" required)
                        .dl
                            .dt
                                p.span 経験の有無
                            .dd.radioList
                                .list
                                    .radioBox
                                        .radio
                                            input(type="radio" class="checkExp" name='checkExp' value="未経験" data-displaynameattr="経験の有無")
                                            label 未経験
                                .list
                                    .radioBox
                                        .radio
                                            input(type="radio" class="checkExp" name='checkExp' value="1～5年" data-displaynameattr="経験の有無")
                                            label 1～5年
                                .list
                                    .radioBox
                                        .radio
                                            input(type="radio" class="checkExp" name='checkExp' value="6年以上" data-displaynameattr="経験の有無")
                                            label 6年以上
                        .dl
                            .dt
                                p.span ご質問
                            .dd
                                textarea(name="ご質問" class="msg" placeholder="お気軽にご質問ください。" data-displaynameattr="ご質問")
                                .telBox
                                    p ※3 営業日以内に返信がない場合は
                                    a(href="tel:0648077170") 
                                        div 
                                            p お電話
                                    p 下さい。
                        .privacy
                            .agreeBox
                                p 個人情報の取り扱いについて
                                p 株式会社サンデンサービスでは個人情報を適切に管理運用するための基本的事項を定めています。<br>・個人情報の利用目的<br>個人情報は当社からご連絡する目的のためのみに取得し、取得した個人情報については不正利用・紛失・破壊・改ざん、<br>および漏えいに対し適切な予防ならびに是正に関する措置を適切に講じます。<br>・個人情報の第三者への開示・提供の禁止<br>お客様の個人情報について、お客様の承諾が無い限り第三者に開示、提供を一切いたしません。 ご提供いただいた個人情報を取り扱うにあたり管理責任者を置き、適切な管理を行っております。<br>・ご本人の照会<br>個人情報の照会・修正・削除などをご希望される場合には、ご本人であることを確認の上対応させていただきます。<br>・法令、規範の遵守と見直し<br>保有する個人情報について日本の法令その他規範を遵守するとともに、本規約の内容を適宜見直しその改善に努めます。
                                p 本ポリシーに関するお問い合わせは，下記の窓口までお願いいたします。
                                p 株式会社サンデンサービス
                                p 住所：千葉県四街道市物井1530-5
                                .tel
                                    p 電話番号：
                                    a(href="tel:0434235901")
                                        div
                                            p 043-423-5901
                        .checkbox.agreeCheck
                            label
                                input(type="checkbox")
                                span 個人情報の取り扱いについて同意する
                        button(type="submit")
                            p 応募する
    .pagingPanel.fadeUp
        .secWrap02
            .ul.clearfix
                .li.prev
                    a(href="/")
                        div
                            p.em HOME
                            p.span ホーム
                .li.next
                    a(href="working")
                        div
                            p.em WORKING
                            p.span 働く環境
// △メイン△
script(src="../js/jquery.jpostal.js")
script(src="../js/formRecruit.js")
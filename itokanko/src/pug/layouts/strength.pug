.strengthMain.main
	.pageKvPanel
		.pageKvTtl
			h1 伊藤管工の強み
	.strengthSection
		.topSecTtlContainer
			.secWrap01
				.pageSecTtlBox
					.pageSecTtl
						p Strength
						h2 伊藤管工の強み
				.numberPanel
					.ttlBox
						h3.gothic 伊藤管工の強み01
						p 0ne-stop<br>Service
					.txtBox
						h4.gothic 加工から施工までワンストップで対応
						.txt
							p 設計から加工、組み立て、施工まで一貫して自社で行なっております。<br>一貫してお任せいただくことで、前例のない工事など様々な工事に柔軟に対応できます。<br>さらに業者を挟まないことで費用の削減、納期の短縮を実現できます。
			.listContainer
				.secWrap01
					.listPanel
						.ol.listAnim
							.li.list01
								.dl.gothic
									.dt
										p 1.設計
									.dd
										p ご依頼内容をもとに設計図を作成します。
							.li.list02
								.dl.gothic
									.dt
										p 2.加工
									.dd
										p 自社工場で加工。<br>高い溶接技術を持つ職人が丁寧に仕上げます。
							.li.list03
								.dl.gothic
									.dt
										p 3.組み立て
									.dd
										p 各パーツを自社工場で組み立て。広い工場なので大規模な部品も組み立てが可能です。
							.li.list04
								.dl.gothic
									.dt
										p 4.施工
									.dd
										p 組み立てた製品を現場に運び、設置します。自社で最後まで責任を持って施工します。
		.stepSecContainer
			.secWrap01
				.numberPanel
					.ttlBox
						h3.gothic 伊藤管工の強み02
						p High technical<br>Expertise
					.txtBox
						h4.gothic 高い技術力とフレキシブルな対応
						.txt
							p 高度な溶接技術を持つ職人が、細かなご要望にお応えします。<br>基本的にどんなオーダーもお受けしており、試行錯誤しながらお客さまのオーダー通りに製作・施工しています。<br>難しい場合は代替案を提示し、目的を達成できるようフレキシブルに対応します。
						.btnMore
							a(href="service?sec03")
								div
									p 実績を見る
			.photoListPanel
				.photoList
					.ul
						.li
							img(src="https://itokanko231128.smooooth.jp/system_panel/uploads/images/strength_photo_list_01.png", alt="")
						.li
							img(src="https://itokanko231128.smooooth.jp/system_panel/uploads/images/strength_photo_list_02.png", alt="")
						.li
							img(src="https://itokanko231128.smooooth.jp/system_panel/uploads/images/strength_photo_list_03.png", alt="")
		.stepSecContainer
			.secWrap01
				.numberPanel
					.ttlBox
						h3.gothic 伊藤管工の強み03
						p Fully equipped<br>Facilities
					.txtBox
						h4.gothic 自社工場の充実した設備
						.txt
							p 自社工場は〇〇平米と、大規模な加工にも対応できる十分な広さがあります。<br>〇〇や〇〇など設備も充実。<br>約50名の十分な人員も確保し、お客さまの幅広いオーダーにお応えする体制を整えています。
						.btnMore
							a(href="service?sec02")
								div
									p 設備を見る
			.photoListPanel
				.photoList
					.ul
						.li
							img(src="https://itokanko231128.smooooth.jp/system_panel/uploads/images/strength_photo_list_04.png", alt="")
						.li
							img(src="https://itokanko231128.smooooth.jp/system_panel/uploads/images/strength_photo_list_05.png", alt="")
						.li
							img(src="https://itokanko231128.smooooth.jp/system_panel/uploads/images/strength_photo_list_06.png", alt="")
		.stepSecContainer
			.secWrap01
				.numberPanel
					.ttlBox
						h3.gothic 伊藤管工の強み04
						p Nationwide coverage<br>Available
					.txtBox
						h4.gothic 全国での施工対応
						.txt
							p 兵庫県だけでなく、全国での工事に対応してます。<br>遠方での施工をご検討の方も、お気軽にご相談ください。
						.btnMore
							a(href="contact")
								div
									p ご依頼はこちら
				.photoMap
					.photo
						img(src="https://itokanko231128.smooooth.jp/system_panel/uploads/images/strength_step04_photo.png", alt="")
					.map
						img(src="https://itokanko231128.smooooth.jp/system_panel/uploads/images/strength_step04_map.png", alt="")
